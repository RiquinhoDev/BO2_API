# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server Port (Railway will override this)
PORT=3001

# Environment
NODE_ENV=production

# Test-only comparison mode. Requires a separate Mongo user with read privileges only.
# Refuses startup with writable credentials; disables jobs and shared Redis.
READ_ONLY_MODE=false

# Redis para rate limiting distribuido (REDIS_HOST e obrigatorio em producao;
# defina tambem REDIS_PORT/REDIS_USERNAME/REDIS_PASSWORD quando nao forem defaults)
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_USERNAME=default
# REDIS_PASSWORD=change_me_to_a_redis_password
# JWT da API (obrigatorio, minimo 32 caracteres)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Obrigatorio (segredo dedicado da API antiga, minimo 32 caracteres)
OLD_API_JWT_SECRET=change_me_to_the_old_api_secret_at_least_32_chars
# HMAC-SHA256 enviado no header X-ActiveCampaign-Signature
AC_WEBHOOK_SECRET=change_me_to_a_long_random_webhook_secret_at_least_32_chars
# Default-deny JWT; false e apenas kill switch explicito de emergencia
AUTH_ENFORCE=true
# Rotas locais de teste/debug; o bootstrap recusa true em producao
ENABLE_DEBUG_ROUTES=false
# Origens CORS, separadas por virgula; obrigatorias em producao, sem defaults implicitos
ALLOWED_ORIGINS=https://front.example.com


# Financial Modeling Prep API (Clareza / Tremómetro)
FMP_API_KEY=your_fmp_api_key_here
CLAREZA_REFRESH_TOKEN=change_me_to_a_long_random_token

# CursEduca — provider settings; destructive inactivation remains OFF by default.
CURSEDUCA_API_URL=https://api.curseduca.example
CURSEDUCA_API_KEY=change_me_to_a_curseduca_api_key
CURSEDUCA_AccessToken=change_me_to_a_curseduca_access_token
CURSEDUCA_INACTIVATION_ENABLED=false

# Student OGI summary (frontend-safe flow uses signed token links)
# Obrigatorio (segredo dedicado de acesso estudante, minimo 32 caracteres)
STUDENT_ACCESS_JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
STUDENT_SUMMARY_TOKEN=change_me_to_a_long_random_server_token

# Add other environment variables your app needs
# (Check your existing .env file for complete list)

# ActiveCampaign product-tag mutations remain OFF by default.
AC_TAG_APPLY_ENABLED=false

# CRON execution-history cleanup manual/request-driven mutation; automatic scheduling ignores it.
CRON_EXECUTION_CLEANUP_MUTABLE_EXECUTION_ENABLED=false

# Achievement evaluation manual/request-driven mutation; automatic scheduling ignores it.
# Guru trial manual mutation; automatic scheduling ignores it. Requires both Guru tokens.
GURU_TRIAL_MANUAL_EXECUTION_ENABLED=false
HOTMART_SYNC_MANUAL_EXECUTION_ENABLED=false
ACHIEVEMENT_EVALUATION_MUTABLE_EXECUTION_ENABLED=false
WEEKLY_TAG_SNAPSHOT_MUTABLE_EXECUTION_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Renovação OGI — sync BackOffice → ActiveCampaign (Fase B)
# Ver docs/reference/renewal/RENOVACAO_OGI_BO_PLAN.md (secções 11 e 13).
# Configuração validada no arranque; a feature permanece DESLIGADA por defeito.
# Master desta família RenewalAcSync; outras famílias têm os seus próprios switches.
RENEWAL_AC_SYNC_ENABLED=false
# Generic/Backoffice manual mutable execution; automatic scheduler ignores this switch.
RENEWAL_AC_MANUAL_EXECUTION_ENABLED=false
# Manual RenewalOffer mutation through the guarded Cron path; automatic scheduling ignores this switch.
RENEWAL_OFFER_MANUAL_EXECUTION_ENABLED=false
# Switches por operação (rollout gradual, um de cada vez):
RENEWAL_AC_WRITE_DATES=false
RENEWAL_AC_WRITE_TAGS=false
RENEWAL_AC_PROCESS_REFUNDS=false
# Config adicional da Fase B (defaults seguros se omitidos):
RENEWAL_AC_AUTO_EXECUTE=false
RENEWAL_AC_EXPIRY_FIELD_ID=332
RENEWAL_AC_MAX_CHANGES_PER_RUN=50
# ID opcional; quando ausente, o produto OGI é resolvido pela BD.
# HOTMART_OGI_PRODUCT_ID=ogi-hotmart-product-id

# ─────────────────────────────────────────────────────────────
# Renovação OGI — cargos Discord R.{Mês} + mensagens do bot
# Ver docs/reference/renewal/RENOVACAO_DISCORD_CARGOS_PLAN.md. Feature nasce DESLIGADA.
DISCORD_ROLES_SYNC_ENABLED=false
DISCORD_ROLES_AUTO_EXECUTE=false
# Permite execucao mutavel manual via Cron ou Backoffice; feature nasce DESLIGADA.
DISCORD_ROLES_MANUAL_EXECUTION_ENABLED=false
DISCORD_MESSAGES_ENABLED=false
# Mensagens agendadas de renovação (dia 8 lembrete + dia 15 último aviso a @R.{mês anterior})
# Master switch; cada regra tem ainda o seu enabled na BD. Ver secção 12 do plano Discord.
DISCORD_SCHEDULED_MESSAGES_ENABLED=false
DISCORD_BOT_URL=https://api.serriquinho.com
DISCORD_ROLES_MAX_OPS_PER_RUN=100
# DISCORD_MESSAGE_CHANNEL_ID=<id-canal-isolado-dev>
# BOT_SHARED_SECRET é obrigatório quando qualquer operação Discord está activa.
# Configurar o mesmo segredo neste serviço e no bot; nunca commitar o valor.
# BOT_SHARED_SECRET=<segredo-do-ambiente>
# Canais permitidos para comunicados do bot ("id:nome,id:nome").
# Adicionar o ID também em RENEWAL_MESSAGE_CHANNEL_IDS no serviço do bot.
# DISCORD_MESSAGE_CHANNELS=<id-canal-isolado-dev>:anuncios-alunos

# Main -> remake: operações novas permanecem desligadas no primeiro arranque.
# Activa as sincronizações mutáveis novas e a continuação de renovações do pipeline diário.
# Na cadeia diária aplicam-se também os interruptores dos jobs; os endpoints manuais
# novos usam este switch e dryRun explícito, independentemente do agendamento do job.
SYNC_MUTABLE_EXECUTION_ENABLED=false
# O core Clareza é opt-in; false mantém os leitores anteriores.
CLAREZA_CANONICAL_ENABLED=false
CLAREZA_REFRESH_ENABLED=false
CLAREZA_FMP_EGRESS_ENABLED=false

# Campos AC: confirmar IDs no ambiente de desenvolvimento antes de activar escritas.
# A reconciliação da data de compra exige configuração explícita do campo 334.
# AC_PURCHASE_DATE_FIELD_ID=334
# AC_FIRST_PURCHASE_DATE_FIELD_ID=337
# AC_PURCHASE_STATUS_FIELD_ID=282
# AC_REFUND_DATE_FIELD_ID=324
# Substituir pelos IDs do catálogo isolado de dev; não copiar IDs de produção.
# HOTMART_OGI_PRODUCT_FAMILY_IDS=<id-numerico-1>,<id-numerico-2>
# GURU_CLAREZA_MENSAL_PRODUCT_ID=<id-produto-dev>
# GURU_CLAREZA_ANUAL_PRODUCT_ID=<id-produto-dev>
OGI_NEW_STUDENT_PRICE_THRESHOLD_EUR=167
# Estimativas configuráveis; não representam cotações em tempo real.
FX_RATE_USD_EUR=0.92
FX_RATE_GBP_EUR=1.17
FX_RATE_CHF_EUR=1.05
FX_RATE_CAD_EUR=0.68
FX_RATE_BRL_EUR=0.16
