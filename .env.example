# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server Port (Railway will override this)
PORT=3001

# Environment
NODE_ENV=production

# Redis para rate limiting distribuido (REDIS_HOST e obrigatorio em producao;
# defina tambem REDIS_PORT/REDIS_USERNAME/REDIS_PASSWORD quando nao forem defaults)
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_USERNAME=default
# REDIS_PASSWORD=change_me_to_a_redis_password
# JWT da API (obrigatorio, minimo 32 caracteres)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Obrigatorio (segredo dedicado da API antiga, minimo 32 caracteres)
OLD_API_JWT_SECRET=change_me_to_the_old_api_secret_at_least_32_chars
# HMAC-SHA256 enviado no header X-ActiveCampaign-Signature
AC_WEBHOOK_SECRET=change_me_to_a_long_random_webhook_secret_at_least_32_chars
# Default-deny JWT; false e apenas kill switch explicito de emergencia
AUTH_ENFORCE=true
# Rotas locais de teste/debug; o bootstrap recusa true em producao
ENABLE_DEBUG_ROUTES=false
# Origens CORS, separadas por virgula; obrigatorias em producao, sem defaults implicitos
ALLOWED_ORIGINS=https://front.example.com


# Financial Modeling Prep API (Clareza / Tremómetro)
FMP_API_KEY=your_fmp_api_key_here
CLAREZA_REFRESH_TOKEN=change_me_to_a_long_random_token

# Student OGI summary (frontend-safe flow uses signed token links)
# Obrigatorio (segredo dedicado de acesso estudante, minimo 32 caracteres)
STUDENT_ACCESS_JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
STUDENT_SUMMARY_TOKEN=change_me_to_a_long_random_server_token

# Add other environment variables your app needs
# (Check your existing .env file for complete list)

# ─────────────────────────────────────────────────────────────
# Renovação OGI — sync BackOffice → ActiveCampaign (Fase B)
# Ver docs/reference/renewal/RENOVACAO_OGI_BO_PLAN.md (secções 11 e 13).
# Configuração validada no arranque; a feature permanece DESLIGADA por defeito.
# Master kill switch: nada escreve na AC sem isto ser true.
RENEWAL_AC_SYNC_ENABLED=false
# Switches por operação (rollout gradual, um de cada vez):
RENEWAL_AC_WRITE_DATES=false
RENEWAL_AC_WRITE_TAGS=false
RENEWAL_AC_PROCESS_REFUNDS=false
# Config adicional da Fase B (defaults seguros se omitidos):
RENEWAL_AC_AUTO_EXECUTE=false
RENEWAL_AC_EXPIRY_FIELD_ID=332
RENEWAL_AC_MAX_CHANGES_PER_RUN=50
# ID opcional; quando ausente, o produto OGI é resolvido pela BD.
# HOTMART_OGI_PRODUCT_ID=ogi-hotmart-product-id

# ─────────────────────────────────────────────────────────────
# Renovação OGI — cargos Discord R.{Mês} + mensagens do bot
# Ver docs/reference/renewal/RENOVACAO_DISCORD_CARGOS_PLAN.md. Feature nasce DESLIGADA.
DISCORD_ROLES_SYNC_ENABLED=false
DISCORD_ROLES_AUTO_EXECUTE=false
DISCORD_MESSAGES_ENABLED=false
# Mensagens agendadas de renovação (dia 8 lembrete + dia 15 último aviso a @R.{mês anterior})
# Master switch; cada regra tem ainda o seu enabled na BD. Ver secção 12 do plano Discord.
DISCORD_SCHEDULED_MESSAGES_ENABLED=false
DISCORD_BOT_URL=https://api.serriquinho.com
DISCORD_ROLES_MAX_OPS_PER_RUN=100
DISCORD_MESSAGE_CHANNEL_ID=1182457352012697671
# BOT_SHARED_SECRET=  (Fase D5 — definir aqui E no serviço do bot para activar auth)
# Canais permitidos para comunicados do bot ("id:nome,id:nome").
# Adicionar o ID também em RENEWAL_MESSAGE_CHANNEL_IDS no serviço do bot.
DISCORD_MESSAGE_CHANNELS=1182457352012697671:anuncios-alunos

# ─────────────────────────────────────────────────────────────
# Retenção de histórico
# Por omissão NADA expira. Preencher é um acto deliberado: apaga dados.
# Ver `npm run retention:plan` antes de mexer — simula sem alterar nada.
#
# Só afecta registos PLATFORM_UPDATE (ruído de sincronização, 96% da colecção).
# INACTIVATION, CLASS_CHANGE, STATUS_CHANGE, EMAIL_CHANGE e MANUAL_EDIT nunca
# expiram, e não há variável que os faça expirar.
# Corte largo: todo o ruído de sincronização acima desta idade.
# USER_HISTORY_PLATFORM_UPDATE_DAYS=180
#
# Corte estreito, o mais conservador: só as primeiras observações — registos
# sem campo identificado e com valor anterior nulo ("não havia nada, agora há
# isto"). São o rasto das cargas em massa e não descrevem mudança nenhuma.
# Um registo sem campo mas COM valor anterior descreve uma mudança real e fica.
# USER_HISTORY_FIRST_OBSERVATION_DAYS=180
#
# Retenção dos snapshots de utilizador. Só o mais recente de cada aluno é lido;
# o resto existe para o diff da sincronização seguinte. Aplicado por
# `npm run retention:apply`, não pelo arranque.
# USER_SNAPSHOT_DAYS=2

# ─────────────────────────────────────────────────────────────
# Painel de Capacidade & Consumo (GET /api/ops/capacity)
# A medição funciona sem nada disto configurado; estas variáveis só acrescentam
# o denominador — sem tecto, o painel mostra volume mas não mostra "% do limite".

# Railway: token de conta/equipa com leitura de consumo + id do projeto.
# Sem os dois, o cartão de custo aparece como indisponível.
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=

# Tectos contratados. Preencher com os números do plano em vigor.
# FMP_PLAN_CALLS_PER_DAY=3000
# Atlas M0 = 512 MB. Usar MB nos planos pequenos; GB existe para os grandes.
# MONGO_PLAN_STORAGE_MB=512
# MONGO_PLAN_STORAGE_GB=5
# REDIS_PLAN_MEMORY_MB=512
# RAILWAY_SERVICE_MEMORY_GB=8
# RAILWAY_MONTHLY_BUDGET_USD=50
