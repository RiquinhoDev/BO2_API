{
  "name": "bo2-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "private": true,
  "packageManager": "npm@11.9.0",
  "license": "MIT",
  "dependencies": {
    "@types/moment": "^2.13.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongodb": "^7.0.0",
    "mongoose": "^8.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "p-queue": "^8.1.0",
    "redis": "^5.8.0",
    "winston": "^3.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.14",
    "@types/node-schedule": "^2.1.7",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "lint": "eslint src --max-warnings=0",
    "test": "jest --selectProjects unit integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:load": "jest --selectProjects load",
    "test:e2e": "jest --selectProjects e2e --passWithNoTests",
    "maintenance:users-v2-indexes": "node dist/scripts/maintenance/ensure-users-v2-indexes.js",
    "maintenance:ac-webhook-leases": "node dist/scripts/maintenance/backfill-ac-webhook-receipt-leases.js",
    "renewal:check-names": "ts-node --transpile-only scripts/renewal/check-turma-names.ts",
    "renewal:ensure-generic": "ts-node --transpile-only scripts/renewal/ensure-generic-offer.ts",
    "renewal:sync": "ts-node --transpile-only scripts/renewal/sync-offers.ts",
    "reactivate:expired-fix": "ts-node --transpile-only scripts/maintenance/reactivate-wrongly-inactivated.ts",
    "daily-pipeline:step5": "ts-node scripts/run-daily-pipeline-test.ts",
    "validate:full": "npm run build && npm run lint && npm test",
    "types:check": "tsc --noEmit --pretty false",
    "lint:baseline:prune": "eslint src --prune-suppressions --max-warnings=0",
    "routes:catalog:check": "node scripts/reconcile-route-catalog.mjs",
    "routes:catalog:update": "node scripts/reconcile-route-catalog.mjs --write",
    "contracts:responses:check": "node scripts/generate-response-contract-catalog.mjs --check",
    "contracts:responses:update": "node scripts/generate-response-contract-catalog.mjs --write",
    "scalability:reads:check": "node scripts/generate-scalability-read-inventory.mjs --check",
    "scalability:reads:update": "node scripts/generate-scalability-read-inventory.mjs --write",
    "scalability:operational": "ts-node --transpile-only scripts/validate-scalability-operational.ts"
  }
}
